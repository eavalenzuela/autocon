[Unit]
Description=Autocon - automatic video converter
After=local-fs.target
# Give up after 5 failed starts in 5 minutes instead of retrying forever.
# A persistent startup error (e.g. the venv losing its packages after a
# system Python upgrade) otherwise re-logs the same traceback every 5s.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/gits/autocon/.venv/bin/python3 %h/gits/autocon/autocon.py
Restart=on-failure
RestartSec=5
# Keep background transcodes from starving interactive use
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target
